{
  "expo": {
    "name": "Zijn we al autonoom? DDW",
    "slug": "ZWAA DDW",
    "version": "1.1.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "zwaa-ddw-app",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/zwaa-app-icon.icon",
      "bundleIdentifier": "studio.falkland.zijnwealautonoom.ddw",
      "supportsTablet": true
    },
    "android": {
      "package": "studio.falkland.zijnwealautonoom.ddw",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "@maplibre/maplibre-react-native",
      [
        "expo-asset",
        {
          "assets": [
            "../data/db/are-we-dependent.db"
          ]
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@fontsource/familjen-grotesk/files/familjen-grotesk-latin-400-normal.woff2",
            "node_modules/@fontsource/familjen-grotesk/files/familjen-grotesk-latin-700-normal.woff2"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      [
        "expo-build-properties",
        {
          "ios": {
            "usePrecompiledModules": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
