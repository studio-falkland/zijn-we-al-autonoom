{
  "name": "@are-we-dependent/data",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "typeorm": "tsx ../node_modules/.bin/typeorm",
    "migrations:generate": "npm run typeorm -- migration:generate -d src/dindexb.ts src/migrations/m",
    "migrations:up": "npm run typeorm -- migration:run -d src/index.ts",
    "preinstall": "npx only-allow pnpm"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "typeorm": "^0.3.21-dev.87b9fad"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./const": {
      "import": "./dist/const.js",
      "types": "./dist/const.d.ts"
    },
    "./hierarchy": {
      "import": "./dist/hierarchy.js",
      "types": "./dist/hierarchy.d.ts"
    }
  }
}
